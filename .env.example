# Copia este archivo a .env y completa los valores. .env no se sube a git.

# API del backend (vria-backend)
API_URL=http://localhost:8080/api/v1

# Cloudinary (subida unsigned). NUNCA pongas aqui el API_KEY ni el API_SECRET:
# todo lo que esta en el frontend queda visible en el navegador.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_UPLOAD_PRESET=vria_products_unsigned
CLOUDINARY_FOLDER=vria/products
